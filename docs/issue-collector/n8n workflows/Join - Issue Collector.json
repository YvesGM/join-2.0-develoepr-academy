    {
      "parameters": {
        "jsCode": "const raw = $json.content?.parts?.[0]?.text;\n\nif (typeof raw !== \"string\" || !raw.trim()) {\n  return [{\n    json: {\n      valid: false,\n      errorCode: \"EMPTY_AI_OUTPUT\",\n    },\n  }];\n}\n\ntry {\n  const parsed = JSON.parse(raw);\n\n  return [{\n    json: {\n      title: parsed.title ?? \"\",\n      description: parsed.description ?? \"\",\n      category: parsed.category ?? \"\",\n      priority: parsed.priority ?? \"\",\n      dueDate: parsed.dueDate ?? \"\",\n    },\n  }];\n} catch {\n  return [{\n    json: {\n      valid: false,\n      errorCode: \"INVALID_AI_JSON\",\n    },\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        -320
      ],
      "id": "3fc3281f-8ced-4d36-be4f-d0de0c6c11d3",
      "name": "Parse AI Output"
    },
    {
      "parameters": {
        "jsCode": "const categories = [\"user-story\", \"technical-task\"];\nconst priorities = [\"urgent\", \"medium\", \"low\"];\n\nconst titleValid =\n  typeof $json.title === \"string\" &&\n  $json.title.trim().length > 0;\n\nconst descriptionValid =\n  typeof $json.description === \"string\" &&\n  $json.description.trim().length > 0;\n\nconst categoryValid =\n  categories.includes($json.category);\n\nconst priorityValid =\n  priorities.includes($json.priority);\n\nconst dueDateValid =\n  /^\\d{4}-\\d{2}-\\d{2}$/.test($json.dueDate ?? \"\");\n\nconst valid =\n  titleValid &&\n  descriptionValid &&\n  categoryValid &&\n  priorityValid &&\n  dueDateValid;\n\nreturn [{\n  json: {\n    ...$json,\n    valid,\n    errorCode: valid ? null : \"INVALID_AI_OUTPUT\",\n  },\n}];"
      },
